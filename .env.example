# All of these are optional and read at RUNTIME (server only). Without them the
# app still works: rule-based assistant, OSM-only imports, pre-baked Jev tables.

# Gemini (planner, satellite vision layout, local intel, narration). Comma-separate several keys to rotate.
GEMINI_API_KEYS=
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# TypeSafe Jev (fast behaviour judgments / quick-pick scoring)
TYPESAFE_API_KEY=

# Optional Google Static Maps satellite imagery (falls back to Esri World Imagery)
GOOGLE_MAPS_API_KEY=

# Optional OSM endpoint overrides
OSM_OVERPASS_URL="https://lz4.overpass-api.de/api/interpreter"
